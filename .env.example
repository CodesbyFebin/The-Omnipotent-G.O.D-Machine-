# GOD Machine — environment variables
# Copy to .env for local development. Never commit .env.

# ---- Web app ----
# Public URL the browser reaches the web app at.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Database (local dev via docker compose) ----
DATABASE_URL=postgres://god:god@localhost:5432/god_dev

# ---- Redis (local dev via docker compose) ----
REDIS_URL=redis://localhost:6379/0

# ---- Object storage (local dev via MinIO) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=godminio
S3_SECRET_ACCESS_KEY=godminiosecret
S3_BUCKET_ARTIFACTS=god-artifacts

# ---- Session / crypto ----
# Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-locally-only

# ---- Model providers (optional; leave blank for local-only) ----
# Set only the providers you want the router to consider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ---- Router mode default ----
# One of: FREE, PRIVATE, BALANCED, FAST, QUALITY, P99
GOD_ROUTER_MODE=FREE

{
  "name": "god-machine",
  "version": "0.0.1",
  "private": true,
  "description": "GOD Machine — Open Agentic Development OS",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "dev": "pnpm --filter @god/web dev",
    "compose:up": "docker compose -f infrastructure/compose/dev.yml up -d",
    "compose:down": "docker compose -f infrastructure/compose/dev.yml down"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3"
  }
}
